@HelpDeskPro_API_HostAddress = http://localhost:5239
@accessToken = replace-with-a-valid-jwt
@ticketId = 1
@agentUserId = 2

### Change ticket status (Admin or assigned Agent; only allowed transitions succeed)
PUT {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "inProgress"
}

### Create a ticket
POST {{HelpDeskPro_API_HostAddress}}/api/tickets
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Cannot connect to VPN",
  "description": "The VPN client fails to connect from my workstation.",
  "categoryId": 1,
  "priority": "high"
}

### List tickets visible to the authenticated user
GET {{HelpDeskPro_API_HostAddress}}/api/tickets
Authorization: Bearer {{accessToken}}

### Search, filter, sort, and paginate visible tickets
GET {{HelpDeskPro_API_HostAddress}}/api/tickets?search=VPN&status=open&priority=high&categoryId=1&sortBy=updatedAtUtc&sortDirection=desc&pageNumber=1&pageSize=10
Authorization: Bearer {{accessToken}}

### List overdue tickets visible to the authenticated user
GET {{HelpDeskPro_API_HostAddress}}/api/tickets/overdue
Authorization: Bearer {{accessToken}}

### Get a ticket visible to the authenticated user
GET {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}
Authorization: Bearer {{accessToken}}

### Update an editable ticket
PUT {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "VPN connection failure",
  "description": "The VPN client still fails to connect.",
  "categoryId": 1,
  "priority": "high"
}

### Assign or reassign a ticket (Admin only)
PUT {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}/assignment
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "agentUserId": {{agentUserId}}
}

### Unassign a ticket (Admin only)
PUT {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}/assignment
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "agentUserId": null
}

### Add a ticket comment (creator, assigned Agent, or Admin)
POST {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}/comments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "commentText": "The troubleshooting steps are underway."
}

### List ticket comments (creator, assigned Agent, or Admin)
GET {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}/comments
Authorization: Bearer {{accessToken}}

### View ticket audit history (creator, assigned Agent, or Admin)
GET {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}/history
Authorization: Bearer {{accessToken}}

### Delete a ticket (Admin only)
DELETE {{HelpDeskPro_API_HostAddress}}/api/tickets/{{ticketId}}
Authorization: Bearer {{accessToken}}
